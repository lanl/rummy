fn finalize() {
    print("Done parsing")
}

fn nu(r) {
    return alpha * h * h * sqrt(r)
}
fn density(r) {
    # 3*pi*nu*rho = mdot
    return mdot/(3*pi*nu(r)) 
}

h = .05
alpha = 1e-3
mdot = 3*pi * alpha * h**2 * 1.0 

title = "nbody_test"

<artemis>
problem = "disk"             # name of the pgen
coordinates = "cylindrical"  # coordinate system

<parthenon/job>
problem_id = title  # problem ID: basename of output filenames

<parthenon/output(out1)>
variables = "gas.prim.density",  &
            "gas.prim.velocity", &
            "gas.prim.pressure"
file_type = "hdf5"  # HDF5 data dump
dt        = 0.1   # time increment between outputs

<parthenon/output(out2)>
file_type = "rst"
dt = 2*pi

<parthenon/time>
nlim       = -1    # cycle limit
tlim       = 10*parthenon.out2.dt # time limit
integrator = "rk2"   # time integration algorithm
ncycle_out = 1     # interval for stdout summary info

<parthenon/mesh>
nx1    = 128                 # Number of zones in X1-direction
x1min  = 0.3                 # minimum value of X1
x1max  = 4.3                 # maximum value of X1
ix1_bc = "ic"                  # Inner-X1 boundary condition flag
ox1_bc = "ic"                  # Outer-X1 boundary condition flag

nx2    = nx2                  # Number of zones in X2-direction
x2min  = -pi  # minimum value of X2
x2max  = pi   # maximum value of X2
ix2_bc = "periodic"            # Inner-X2 boundary condition flag
ox2_bc = "periodic"            # Outer-X2 boundary condition flag

nx3    = 32                  # Number of zones in X3-direction
x3min  = -1.0                # minimum value of X3
x3max  = 1.0                 # maximum value of X3
ix3_bc = "ic"                  # Inner-X3 boundary condition flag
ox3_bc = "ic"                  # Outer-X3 boundary condition flag

<parthenon/meshblock>
nx1 = 32  # Number of cells in each MeshBlock, X1-dir
nx2 = 32  # Number of cells in each MeshBlock, X2-dir
nx3 = 32  # Number of cells in each MeshBlock, X3-dir

<physics>
gas = true
# dust = true
gravity = true
nbody = true
viscosity = true

<gas>
cfl = 0.3
reconstruct = "plm"
riemann = "hllc-general"
dfloor = 1.0e-10
siefloor = 1.0e-10

<gas/eos/ideal>
gamma = 1.4

<gas/viscosity>
type = "alpha"
alpha = alpha


<gravity/nbody>
integrator = "none"

<./particle(star)>
mass = 1.0
couple = 1

<./particle(star)/soft>
type = "none"

<./particle(star)/initialize>

<./particle(planet)>
mass = 1.0
couple = 1

<./particle(planet)/soft>
type = "none"


<./binary>
primary = "star"
secondary = "planet"
a = 1.0
mass = 1.0

<problem>
r0 = gravity.nbody.binary.a * .5
rho0 = density(r0*2)
dslope = -2.25
flare = 0.25
h0 = h
polytropic_index = 1

finalize()