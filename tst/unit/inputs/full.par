
<problem>
  title = "simple"
<problem/output>
 file = "output.txt"

<problem(prob)>
  title = "my problem"

<problem(prob)/mat(mat1)>
  name = "material 1"
  gamma = 1.4

<problem(prob)/mat(mat2)>
  name = "material 2"
  gamma = prob.mat1.gamma * 1.5
<./eos>
 type = "ideal"


